# Copy to .env on the server, then run: chmod 600 .env
# Never commit .env.

# The address people use. Its DNS record must already point at this server.
SITE_ADDRESS=trademind.example.com

# INVITE-ONLY ACCESS
# People need this code to upload a file. Anyone can still see the example report.
# Make a long random one on the server:
#   python3 -c "import secrets; print(secrets.token_urlsafe(16))"
# Give it to each tester in their invite. To change it, edit it here and restart:
#   docker compose up -d
# Leave it empty only if you want the site open to everyone. Do not do that while the market
# data is Yahoo's, which is not licensed for a public app (see README.md).
ACCESS_CODE=

# Optional. With no key, explanations are written by the tool instead of an AI model.
# Free key: console.groq.com. Paste it after the = sign, with no quotes.
GROQ_API_KEY=

# How many uploads one visitor can make in an hour. Wrong access codes count too.
# 0 turns the limit off.
UPLOADS_PER_HOUR=10
